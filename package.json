{
  "name": "token-scope-node",
  "version": "1.0.0",
  "description": "Track Claude Code requests, tokens and estimated cost. Fastify API for Vercel and Neon with a React dashboard.",
  "main": "dist/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "migrate": "node --env-file-if-exists=.env -r ts-node/register scripts/migrate.ts",
    "web:dev": "npm --prefix web run dev"
  },
  "keywords": [
    "claude-code",
    "telemetry",
    "opentelemetry",
    "otlp",
    "token-usage",
    "fastify",
    "neon",
    "vercel"
  ],
  "author": "Jesse Nicodemus",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jessetechgeek/token-scope.git"
  },
  "homepage": "https://github.com/jessetechgeek/token-scope#readme",
  "bugs": {
    "url": "https://github.com/jessetechgeek/token-scope/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
